rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Files live under <room doc ID>/<random>-<name> and only while that room is alive.
    function roomIsAlive(roomId) {
      let room = firestore.get(/databases/(default)/documents/rooms/$(roomId));
      return room != null && room.data.createdAt > request.time - duration.value(15, 'm');
    }

    match /{roomId}/{fileName} {
      allow read: if request.auth != null && roomIsAlive(roomId);
      allow create: if request.auth != null
        && roomId.matches('^[0-9a-f]{64}$')
        && request.resource.size <= 100 * 1024 * 1024
        && roomIsAlive(roomId);
      allow delete: if request.auth != null;
    }
  }
}
