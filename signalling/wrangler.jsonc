{
  "name": "rooms-signalling",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "SIGNAL", "class_name": "Signal" }],
  },
  // SQLite-backed Durable Objects are available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Signal"] }],
  "vars": {
    // Comma-separated. The workers.dev entry covers the site's own address
    // and its preview builds before the custom domain is set up.
    "ALLOWED_ORIGINS": "https://rooms.saklani.dev,https://*.devangsaklani.workers.dev",
  },
}
