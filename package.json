{
  "name": "roomssaklanidev",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/crypt.test.mjs",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --project demo-rooms --only firestore,storage \"node --test tests/rules.test.mjs\"",
    "firebase": "npx -y firebase-tools@15",
    "deploy:backend": "npx -y firebase-tools@15 deploy --only firestore:rules,storage,functions",
    "preview:pages": "vite build && npx -y wrangler@4 pages dev build --port 8788",
    "test:e2e": "npx -y firebase-tools@13 emulators:exec --project demo-rooms --only auth,firestore,storage \"playwright test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^2.0.7",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^2.0.3",
    "@sveltejs/kit": "1.15.7",
    "@types/countdown": "^0.0.8",
    "@types/html-minifier": "^4.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/uuid": "^9.0.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.22",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "svelte": "^3.58.0",
    "svelte-check": "^3.2.0",
    "svelte-preprocess": "^5.0.3",
    "svelte-seo": "^1.5.3",
    "tailwindcss": "^3.3.1",
    "tslib": "^2.5.0",
    "typescript": "^5.0.4",
    "vite": "^4.2.1"
  },
  "type": "module",
  "dependencies": {
    "clsx": "^1.2.1",
    "countdown": "^2.6.0",
    "firebase": "^9.19.1",
    "gsap": "^3.11.5",
    "html-minifier": "^4.0.0",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.3",
    "sass": "^1.62.0",
    "unique-names-generator": "^4.7.1"
  },
  "packageManager": "pnpm@10.33.4"
}
