{
  "name": "roomssaklanidev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/crypt.test.mjs",
    "test:rules": "npx -y firebase-tools@13 emulators:exec --project demo-rooms --only firestore,storage \"node --test tests/rules.test.mjs\"",
    "firebase": "npx -y firebase-tools@15",
    "deploy:backend": "npx -y firebase-tools@15 deploy --only firestore:rules,storage,functions",
    "preview:pages": "vite build && npx -y wrangler@4 pages dev build --port 8788",
    "test:e2e": "npx -y firebase-tools@13 emulators:exec --project demo-rooms --only auth,firestore,storage \"playwright test\""
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "peerjs": "^1.5.5",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
