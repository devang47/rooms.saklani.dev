{
  "name": "roomssaklanidev",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && cp build/200.html build/404.html",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/crypt.test.mjs",
    "test:rules": "npx -y firebase-tools@15 emulators:exec --only firestore,storage --project demo-rooms \"node --test --test-force-exit tests/rules.test.mjs\"",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test:signal": "node --test --test-force-exit signalling/signal.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/qrcode": "^1.5.5",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass": "^1.108.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.0",
    "vite": "^8.3.6"
  },
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#stores": "./src/stores/index.ts",
    "#utils/*": "./src/utils/*",
    "#helpers/*": "./src/helpers/*",
    "#styles/*": "./src/styles/*"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "firebase": "^13.2.0",
    "peerjs": "^1.5.4",
    "qrcode": "^1.5.3",
    "unique-names-generator": "^4.7.1"
  }
}
