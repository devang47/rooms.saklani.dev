rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep in sync with ROOM_TTL_MS in firebase-functions/index.js.
    function roomTtlMs() {
      return 15 * 60 * 1000;
    }

    // Anything not matched below (including every other collection) is denied.
    match /rooms/{roomId} {
      // The room ID is derived from the room code, so knowing the exact path is
      // the access check. Anonymous sign-in is free and adds nothing to reads.
      // Listing stays off so nobody can enumerate rooms.
      allow get: if true;
      allow list: if false;

      // 64 hex chars is the current ID. 128 is the previous client's ID: drop it
      // once that client has been replaced in production for 15 minutes.
      allow create: if signedIn()
        && roomId.matches('^[a-f0-9]{64}([a-f0-9]{64})?$')
        && request.resource.data.keys().hasOnly(['timestamp'])
        && request.resource.data.timestamp is int
        // Bounds forged timestamps, which would otherwise keep a room alive forever.
        && request.resource.data.timestamp > request.time.toMillis() - 600000
        && request.resource.data.timestamp < request.time.toMillis() + 600000;

      allow delete: if signedIn();

      match /data/{messageId} {
        allow read: if true;

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['data', 'timestamp', 'device'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 350000
          && request.resource.data.timestamp is int
          && request.resource.data.device is string
          && request.resource.data.device.size() <= 128
          // Fails for a missing room too, because get() errors on a missing doc.
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.timestamp
            > request.time.toMillis() - roomTtlMs();

        allow delete: if signedIn();
      }
    }
  }
}
