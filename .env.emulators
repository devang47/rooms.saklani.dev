# `vite --mode emulators`: local Firebase emulators + local PeerJS server (used by e2e tests).
# Demo values only, nothing secret. Overrides .env.
VITE_USE_EMULATORS=true
VITE_API_KEY=demo-key
VITE_AUTH_DOMAIN=demo-rooms.firebaseapp.com
VITE_PROJECT_ID=demo-rooms
VITE_STORAGE_BUCKET=demo-rooms.appspot.com
VITE_SENDER_ID=0
VITE_APP_ID=1:0:web:0
VITE_MEASUREMENT_ID=
VITE_PEERJS_HOST=localhost
VITE_PEERJS_PORT=9000
VITE_PEERJS_SECURE=false
